{
  "manifests": [
    {
      "path": "Cargo.toml",
      "cpu_features": "native,cpu",
      "target": "target",
      "metal": true
    },
    {
      "path": "crates/breeze-tts/Cargo.toml",
      "cpu_features": "cpu",
      "target": "target/breeze-native",
      "metal": true
    },
    {
      "path": "crates/hy-mt/Cargo.toml",
      "cpu_features": "native,cpu",
      "target": "target/omni-api-cpu",
      "strict_clippy": true,
      "metal": true
    },
    {
      "path": "crates/minicpm-v/Cargo.toml",
      "cpu_features": "native,cpu",
      "target": "target/minicpm-v-cpu",
      "metal": true,
      "cpu_only_tests": {
        "greedy_parity": "Full 1B NdArray text generation; explicit optional CPU diagnostic, not routine Metal acceptance",
        "image_parity": "Full 1B NdArray image generation; Metal image parity is covered by metal_spot"
      }
    },
    {
      "path": "crates/lfm3-omni/Cargo.toml",
      "cpu_features": "native,cpu",
      "target": "target/minicpm-v-cpu",
      "metal": true
    },
    {
      "path": "crates/omni-rsi/Cargo.toml",
      "cpu_features": "native,cpu,training",
      "target": "target/minicpm-v-cpu",
      "metal": true
    },
    {
      "path": "crates/qwen-image/Cargo.toml",
      "cpu_features": "cpu",
      "target": "target/qwen-image-test",
      "metal": true
    },
    {
      "path": "crates/omni-music/Cargo.toml",
      "cpu_features": "cpu",
      "target": "target/omni-music-cpu",
      "metal": true
    },
    {
      "path": "crates/omni-api/Cargo.toml",
      "cpu_features": "cpu",
      "target": "target/omni-api-cpu",
      "strict_clippy": true,
      "metal": false
    },
    {
      "path": "crates/burn-ane/Cargo.toml",
      "target": "target/apple-shared-ane",
      "strict_clippy": true,
      "metal": true
    },
    {
      "path": "crates/omni-kernel/Cargo.toml",
      "target": "target/apple-shared-ane",
      "metal": true
    },
    {
      "path": "prototypes/makepad/Cargo.toml",
      "target": "target/makepad-native",
      "metal": true
    },
    {
      "path": "prototypes/tts-gemv/Cargo.toml",
      "target": "target/tts-playback-checks",
      "metal": false,
      "experimental": true
    },
    {
      "path": "prototypes/int8-gemm/Cargo.toml",
      "target": "target/int8-gemm",
      "metal": false,
      "experimental": true
    },
    {
      "path": "crates/mtl4/Cargo.toml",
      "cpu_features": "",
      "target": "target/mtl4",
      "metal": true
    },
    {
      "path": "crates/resin-metal/Cargo.toml",
      "cpu_features": "cpu",
      "target": "target/resin-metal",
      "metal": true
    }
  ],
  "profiles": {
    "dev": {
      "debug": "line-tables-only",
      "incremental": false
    },
    "debug-full": {
      "inherits": "dev",
      "debug": 2,
      "incremental": true
    }
  },
  "target_variants": [
    {
      "manifest": "crates/qwen-image/Cargo.toml",
      "target": "target/qwen-image-rewrite",
      "reason": "Separate historical rewrite comparison from the production attention baseline"
    },
    {
      "manifest": "prototypes/makepad/Cargo.toml",
      "target": "target/makepad-image",
      "reason": "Retained native image integration comparison build"
    }
  ],
  "dependency_policy": {
    "training_manifests": [
      "crates/omni-rsi/Cargo.toml"
    ],
    "ndarray_fallbacks": {
      "crates/burn-ane/Cargo.toml": "Experimental ANE host operations retain their supported NdArray fallback"
    },
    "aligned_versions": {
      "serde_json": "1.0.154"
    },
    "vendored_paths": {
      "burn": "vendor/burn",
      "burn-cubecl": "vendor/burn-cubecl",
      "burn-fusion": "vendor/burn-fusion",
      "burn-router": "vendor/burn-router",
      "cubecl-common": "vendor/cubecl-common",
      "cubecl-cpp": "vendor/cubecl-cpp",
      "cubecl-runtime": "vendor/cubecl-runtime",
      "cubecl-wgpu": "vendor/cubecl-wgpu",
      "cubek-matmul": "vendor/cubek-matmul"
    },
    "unsupported_features": [
      "wasm",
      "webgpu",
      "vulkan"
    ]
  },
  "forbidden_runtime_packages": [
    "pyo3",
    "cpython",
    "rustpython",
    "rustpython-vm",
    "mlx-rs",
    "mlx-sys"
  ]
}
